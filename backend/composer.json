{
  "name": "hypnose-stammtisch/backend",
  "description": "Backend API for Hypnose Stammtisch community calendar",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "eluceo/ical": "~2.17.0",
    "nesbot/carbon": "^3.15.1",
    "phpmailer/phpmailer": "^7.2.0",
    "vlucas/phpdotenv": "5.8.0",
    "web-auth/webauthn-lib": "^5.3.12"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.6",
    "squizlabs/php_codesniffer": "^4.0.4",
    "phpstan/phpstan": "^2.3.5"
  },
  "autoload": {
    "psr-4": {
      "HypnoseStammtisch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HypnoseStammtisch\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs": "phpcs --standard=PSR12 src/",
    "cs-fix": "phpcbf --standard=PSR12 src/",
    "analyse": "phpstan analyse src/",
    "migrate": "php migrations/migrate.php"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
